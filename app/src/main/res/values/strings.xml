    <string name="ui_headline">AirPlay 音频接收</string>
    <string name="ui_hint">先让车机连上 iPhone 的个人热点，再打开下面的开关。之后在 iPhone 的控制中心或音乐 App 的播放设备列表里就能看到本车机。</string>

    <string name="ui_service_switch">接收服务</string>
    <string name="ui_start_on_boot">开机后自动开启</string>

    <string name="ui_airplay2">使用 AirPlay 2</string>
    <string name="ui_airplay2_hint">关闭后回到 AirPlay 1（RAOP）。AirPlay 2 断开时手机会主动结束会话；它没有 DACP，但有自己的遥控通道——要上一首 / 播放暂停 / 下一首，请打开下面的「AP2 反向控制（实验性）」。AirPlay 1 用 DACP，且会重传丢失的音频包。切换会重启服务。</string>
    <string name="ui_airplay2_applied">协议已切换，正在重启服务</string>

    <string name="ui_ap2_remote_switch">AP2 反向控制</string>
    <string name="ui_ap2_remote_hint">AirPlay 2 没有 DACP，但事件通道上可以发 sendMediaRemoteCommand——shairport-sync 的 MPRIS/D-Bus 遥控走的就是它。打开后上一首 / 播放暂停 / 下一首会作为 AirPlay 2 自己的遥控命令发给 iPhone，不需要 DACP 凭据，也不需要 MFi 身份。命令要指名所在的分组（SETUP 里的 groupUUID），本机会自动取。切换会重启服务。</string>
    <string name="ui_ap2_remote_applied">AP2 反向控制已切换，正在重启服务</string>
    <string name="ui_ap2_remote">AP2 反向控制</string>
