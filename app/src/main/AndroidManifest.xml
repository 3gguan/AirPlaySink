<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- WifiLock.acquire() is guarded by WAKE_LOCK; without it the lock silently fails and the
         hotspot link is dropped the moment the screen goes off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- On Android 12+ a granted overlay permission exempts background foreground-service starts.
             It is also how the receiver revives itself after a process kill with the screen off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets the app ask (with a dialog) to be exempted from Doze / App Standby, which some head
         unit power managers run aggressively. The permission only enables the request dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- The receive and decode threads are raised to audio priority so the head unit cannot starve
         them mid-stream; Process.setThreadPriority refuses that range without this permission. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Android 9 and older only; the car head unit may need it to read the Wi-Fi IP address. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="28" />

    <application
        android:name=".SinkApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_sink"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirPlaySink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateAlwaysHidden"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.AirPlaySink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".SinkService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- BOOT_COMPLETED is a protected broadcast, so only the system can reach this receiver. -->
        <receiver
            android:name=".BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- android.net.wifi.STATE_CHANGE still reaches manifest receivers on Android 10 and is
             how the service is brought back after the process died with the screen off. -->
        <receiver
            android:name=".NetworkAutoStartReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.wifi.STATE_CHANGE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
